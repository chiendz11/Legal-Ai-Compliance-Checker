{
  "additionalProperties": false,
  "description": "Read availability from one exact extraction, not a semantic absence attestation.\n\nText on every page does not prove OCR accuracy, complete reading order, or receipt of\nall related annexes. A verifier needs independent checks before asserting absence.",
  "properties": {
    "hop_dong_id": {
      "minLength": 1,
      "title": "Hop Dong Id",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "extraction_version": {
      "minLength": 1,
      "title": "Extraction Version",
      "type": "string"
    },
    "page_count": {
      "minimum": 1,
      "title": "Page Count",
      "type": "integer"
    },
    "unreadable_pages": {
      "items": {
        "type": "integer"
      },
      "title": "Unreadable Pages",
      "type": "array"
    }
  },
  "required": [
    "hop_dong_id",
    "source_sha256",
    "extraction_version",
    "page_count"
  ],
  "title": "DocumentReadCoverage",
  "type": "object"
}
