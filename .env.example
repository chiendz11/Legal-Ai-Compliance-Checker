DATABASE_URL=postgresql://legal_checker:legal_checker_local_only@127.0.0.1:5433/legal_checker_dev_pdfv4r2_20261110
# Optional: pin a historical DB snapshot instead of capturing current source tables.
KNOWLEDGE_SNAPSHOT_SHA256=4ab2d7ea296ea908e25c09fcb6d5f073f1ebe1917678b36390f803b1c725804a
# Each dev supplies their own local copy of the workbook, outside Git.
SEED_WORKBOOK_PATH=data/private/v750_pdf360_v4r2_runtime_20261110/bang_du_lieu_v7_5_0_PDF360_V4R2_20261110_DEV_VALIDATION.xlsx
# Optional override; otherwise dataset pull uses the pinned public Drive link in configs/.
# DATASET_ARCHIVE_URL=https://drive.google.com/file/d/<FILE_ID>/view
# Source PDF cache: relative paths are resolved from the repository root.
SOURCE_CACHE_DIR=data/private/source_cache
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=30
SOURCE_MAX_BYTES=104857600
# Full-assessment: modules reads real source bytes (upload/cache/HTTP), never QA fallback.
# modules_di_reference: explicitly allow dataset DI for DEV/EVAL; real remaining modules.
# reference: replay all QA (REFERENCE_REPLAY); none: fail unconfigured.
ASSESSMENT_MODULES=none
# C07 in modules mode. offline: no LLM call, criteria stay UNKNOWN; openai: see OPENAI_* below.
ASSESSMENT_LLM=offline
# ASSESSMENT_LLM_MAX_CALLS=20
# Per criterion, in characters; configure to the selected model's input capacity.
# ASSESSMENT_LLM_MAX_CONTEXT_CHARS=80000
# ASSESSMENT_LLM_BATCH_SIZE=1
# C07_LLM_MIN_REQUEST_INTERVAL_SECONDS=0
# Optional explicit study scenario, matched by exact PDF/knowledge SHA only:
# SYNTHETIC_SCENARIO_PATH=backend/src/legal_checker/modules/compliance/scenarios/hd360_001.json
# inline: run jobs in the API process (no Redis); celery: send to the worker via REDIS_URL.
ASSESSMENT_QUEUE=inline
# REDIS_URL=redis://127.0.0.1:6379/0
# RUN_LEASE_SECONDS=600
# RUN_REQUEUE_AFTER_SECONDS=120
REPORT_EXPORT_DIR=data/private/report_exports
# Uploaded contracts (PDF/DOCX, content-addressed by SHA-256).
UPLOAD_DIR=data/private/uploads
# Deployment pinned for new cases; default: the newest active release in the DB.
# DEPLOYMENT_RULE_VERSION=...
DEPLOYMENT_LEGAL_KNOWLEDGE_VERSION=V750_KNOWLEDGE_OWNER_APPROVED_20261110

# Auth. off: every request runs as the dev actor below with all roles (local only).
# on: sign in with accounts from `python -m scripts.users add ...`; needs AUTH_SECRET.
AUTH_MODE=off
# AUTH_SECRET=<at least 32 random characters, never commit it>
# AUTH_SESSION_HOURS=8
# DEV_ACTOR_ID=LOCAL_DEV
# DEV_TENANT_ID=LOCAL_SOURCE_PDF360
# PDF export needs a Unicode TTF; auto-detects DejaVu/Arial, else set:
# REPORT_PDF_FONT=/path/to/DejaVuSans.ttf

# C07 OpenAI provider (install backend[ai]); leave credentials in local .env only.
# OPENAI_API_KEY=...
# Choose a model available to your account with Responses Structured Outputs support.
# OPENAI_MODEL=...
C07_LLM_TIMEOUT_SECONDS=45
C07_LLM_MAX_OUTPUT_TOKENS=3000
C07_LLM_MAX_ATTEMPTS=2
C07_LLM_MAX_RETRY_DELAY_SECONDS=10
C07_LLM_TOTAL_TIMEOUT_SECONDS=120

# Full-text absence review shares the C07 LLM call budget; failures keep UNKNOWN.
ASSESSMENT_FULL_DOCUMENT_REVIEW=on

# Private, independently authored benchmark answers; never use runtime reference outputs.
# Relative paths resolve from the application repository root.
GOLD_DATASET_PATH=data/private/gold

# Historical TEAM-only migration; do not run on the PDF360 v4r2 release:
# python -m scripts.local_db align-runtime
# Set KNOWLEDGE_SNAPSHOT_SHA256 to the returned hash, and
# DEPLOYMENT_LEGAL_KNOWLEDGE_VERSION=V750_RUNTIME_ALIGNMENT_20261108
