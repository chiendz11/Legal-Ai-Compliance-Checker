DATABASE_URL=postgresql://legal_checker:legal_checker_local_only@127.0.0.1:5433/legal_checker_dev_v750_r2_supabase
# Optional: pin a historical DB snapshot instead of capturing current source tables.
# KNOWLEDGE_SNAPSHOT_SHA256=...
# Each dev supplies their own local copy of the workbook, outside Git.
SEED_WORKBOOK_PATH=data/private/v750_source_pdf360_r2_supabase/bang_du_lieu_runtime_v7_5_0_360_STRUCTURED_R2_SUPABASE_DEV_VALIDATION.xlsx
# Optional override; otherwise dataset pull uses the pinned public Drive link in configs/.
# DATASET_ARCHIVE_URL=https://drive.google.com/file/d/<FILE_ID>/view
# Source PDF cache: relative paths are resolved from the repository root.
SOURCE_CACHE_DIR=data/private/source_cache
SOURCE_DOWNLOAD_TIMEOUT_SECONDS=30
SOURCE_MAX_BYTES=104857600

# C07 OpenAI provider (install backend[ai]); leave credentials in local .env only.
# OPENAI_API_KEY=...
# Choose a model available to your account with Responses Structured Outputs support.
# OPENAI_MODEL=...
C07_LLM_TIMEOUT_SECONDS=45
C07_LLM_MAX_OUTPUT_TOKENS=3000
C07_LLM_MAX_ATTEMPTS=2
C07_LLM_MAX_RETRY_DELAY_SECONDS=10
C07_LLM_TOTAL_TIMEOUT_SECONDS=120
